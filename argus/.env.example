# =============================================================================
# ARGUS — Environment Variable Reference
# Copy this file to .env and fill in your values.  NEVER commit .env.
# =============================================================================

# Application
APP_NAME=Argus
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================
# Primary provider: gemini | groq | ollama | openrouter
LLM_PROVIDER=gemini

# Fallback provider (leave blank to disable).
# In production cloud deployments without local Ollama, fallback to another
# cloud provider (e.g. groq).
# Fallback is triggered ONLY after retries on transient errors (429 rate limit,
# 503, network timeout) are exhausted. Auth errors NEVER trigger fallback.
LLM_FALLBACK_PROVIDER=groq

# Strict Benchmark Mode:
# Set to true to disable all fallback behavior during controlled benchmark runs.
# Ensures evaluation results are never silently generated by a fallback model.
STRICT_LLM=false

# =============================================================================
# GOOGLE GEMINI (Cloud Primary)
# Obtain an API key at: https://aistudio.google.com/apikey
# Uses Google's official OpenAI-compatible endpoint:
# https://generativelanguage.googleapis.com/v1beta/openai/
# Supported models (2026): gemini-2.0-flash, gemini-2.5-flash, gemini-1.5-flash
# Note: GEMINI_API_KEY or GOOGLE_API_KEY are both recognized.
# =============================================================================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# =============================================================================
# GROQ (Cloud Alternative / Hosted Fallback)
# Fast inference and generous free tier (no credit card required).
# Obtain an API key at: https://console.groq.com/keys
# Supported models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# =============================================================================
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# =============================================================================
# PER-ROLE MODEL OVERRIDES (Optional)
# Allows specific agents to use dedicated models without altering the global provider.
# If unset, agents use the provider's default model.
# =============================================================================
# VERIFIER_MODEL=gemini-2.0-flash
# RESEARCHER_MODEL=llama-3.3-70b-versatile
# PLANNER_MODEL=gemini-2.0-flash

# =============================================================================
# DISK CACHE (Optional — saves tokens on repeat calls during dev/benchmarks)
# =============================================================================
LLM_CACHE=false
ARGUS_CACHE_DIR=./data/cache/llm

# =============================================================================
# OLLAMA (Local Inference — Offline / Edge)
# Start daemon: ollama serve
# Pull model: ollama pull llama3.2:3b
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Backward-compatible generic override (applies to all providers if set)
# DEFAULT_LLM_MODEL=llama3.2:3b

# =============================================================================
# LEGACY PROVIDERS (Optional during migration)
# =============================================================================
# OPENROUTER_API_KEY=sk-or-your-key-here
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct
# XAI_API_KEY=your-xai-key-here
# XAI_MODEL=grok-3-mini

# =============================================================================
# Storage / Vector DB
# =============================================================================
VECTOR_DB_PATH=./data/vectordb
